* text=auto

*.c text eol=lf
*.h text eol=lf
*.v text eol=lf
*.dts text eol=lf
*.conf text eol=lf
*.tcl text eol=lf
*.sh text eol=lf
*.mk text eol=lf
*.md text eol=lf
*.patch text eol=lf whitespace=-blank-at-eol,-space-before-tab
*.ps1 text eol=crlf
*.cmd text eol=crlf
buildroot-external/board/zynq7020/boot.cmd text eol=lf
# Preserve serial captures, including CR and terminal whitespace.
docs/evidence/*.txt -text whitespace=-blank-at-eol,-blank-at-eof
